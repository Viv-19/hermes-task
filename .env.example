# Copy this file to .env and fill in the key. .env is git-ignored.
# On Render: set OPENROUTER_API_KEY in the service's Environment tab instead.
OPENROUTER_API_KEY=

# Models are tried in this order. If one fails (rate limit, timeout, bad JSON) the next is used.
MODEL_CHAIN=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

LLM_TIMEOUT_S=40
LLM_DEADLINE_S=85
LLM_MAX_TOKENS=4000

# two_stage = router agent, then the chosen skill (2 AI calls per email, real step-by-step workflow)
# single    = one call with all six skills (1 AI call per email)
ROUTER_MODE=two_stage

# 1 = never call OpenRouter, replay canned answers (zero quota use). MOCK_DELAY_S = pause between steps.
MOCK_LLM=0
MOCK_DELAY_S=0.7

MAX_BODY_CHARS=8000
RATE_LIMIT_PER_MIN=10
